// Rule 2: JPS - Local Admin Group Addition - jps-win11-vm01
// Defender custom detection | Continuous (NRT) | High | T1098.007
// Automated actions: Isolate device (Full) + Collect investigation package
// S-1-5-32-544 = the built-in Administrators group's well-known SID (same on every Windows machine, any language)
DeviceEvents
| where DeviceId == "2427dae6ebfd729ae702071b2e679c7ff003f07d"
| where ActionType == "UserAccountAddedToLocalGroup"
| where tostring(parse_json(AdditionalFields).GroupSid) == "S-1-5-32-544"
| project Timestamp, DeviceId, DeviceName, ActionType, AccountSid, AdditionalFields, InitiatingProcessAccountName, ReportId
